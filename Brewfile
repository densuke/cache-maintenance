# Brewfile -- cache-maintenance に必要な Homebrew パッケージ
#
# セットアップ:
#   brew bundle

# ---- 必須ツール ----
brew "just"        # タスクランナー (just lint / just check / just install)
brew "shellcheck"  # シェルスクリプト静的解析 (just lint / just install)

# ---- 開発・テスト用 ----
brew "bats-core"   # bash テストフレームワーク (just test)

# ---- 任意: pip.sh でキャッシュをクリーンする対象 ----
# brew "uv"        # Python パッケージマネージャー (あれば pip.sh が自動検出)
